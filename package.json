{
  "name": "leccorcut02",
  "version": "1.0.0",
  "description": "Editor de vídeo desktop com IA local",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node tests/export-smoke.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.leccorside.leccorcut02",
    "productName": "LeccorCut02",
    "files": ["src/**", "package.json"],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/icon.ico"
    }
  }
}
